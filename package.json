{
  "name": "dsh-openresearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness method pack: mounts the OpenResearch (`orx`) research skills into DSH sessions.",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvk04/dsh-openresearch.git"
  },
  "homepage": "https://github.com/lvk04/dsh-openresearch",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "skills",
    "skills-src",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "scripts": {
    "sync": "node scripts/sync-skills.mjs",
    "check": "node scripts/sync-skills.mjs --check",
    "check:offline": "node scripts/sync-skills.mjs --check --offline",
    "test": "node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  }
}
